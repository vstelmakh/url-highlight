{
    "$schema": "vendor/phpbench/phpbench/phpbench.schema.json",
    "runner.bootstrap": "vendor/autoload.php",
    "runner.path": "benchmarks/",
    "runner.php_config": {
        "memory_limit": "256M",
        "xdebug.mode": "none"
    },
    "report.generators": {
        "custom_compact": {
            "extends": "aggregate",
            "cols": ["benchmark", "subject", "mem_peak", "mean"],
            "baseline_expressions": []
        }
    }
}
